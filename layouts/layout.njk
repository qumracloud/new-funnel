<!DOCTYPE html>
<html lang="{{ localization.language | default('ar') }}" dir="{% if localization.language == 'en' %}ltr{% else %}rtl{% endif %}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0e1a" />
    {% seo %}
    {% qumra_head %}

    {# Tailwind CSS #}
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              ink: { 950: '#05070d', 900: '#0a0e1a', 800: '#0f1424', 700: '#161c34' },
              accent: { DEFAULT: '#7c5cff', 500: '#7c5cff', 400: '#9b86ff' },
              brand: { DEFAULT: '#3ee0c9', 500: '#3ee0c9' }
            },
            fontFamily: {
              display: ['Tajawal', 'Poppins', 'system-ui', 'sans-serif'],
              body: ['Tajawal', 'Poppins', 'system-ui', 'sans-serif']
            }
          }
        }
      }
    </script>

    {# Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    {# Swiper #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    {# AOS for entry animations #}
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet" />

    {# Alpine.js + Collapse plugin #}
    <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <link rel="stylesheet" href="{{ 'style.css' | assets }}" />
  </head>
  <body class="font-display bg-ink-950 text-white antialiased">
    {% template "header" %}
    <main>{% content %}</main>
    {% template "footer" %}

    {% qumra_scripts %}
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        if (window.AOS) AOS.init({ once: true, duration: 700, easing: 'ease-out-cubic', offset: 60 });
      });
    </script>
    <script src="{{ 'main.js' | assets }}"></script>
  </body>
</html>
