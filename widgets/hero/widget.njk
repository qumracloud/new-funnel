{% set hero = widget.data %}
{% set heroImg = product.images[0].fileUrl %}
{% set hasDiscount = product.pricing.compareAtPrice and product.pricing.compareAtPrice > product.pricing.price %}

<section id="top" class="relative overflow-hidden bg-ink-950">
  {# Background glow #}
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[120%] h-[700px] bg-[radial-gradient(ellipse_at_center,_rgba(124,92,255,0.35)_0%,_rgba(62,224,201,0.18)_30%,_transparent_60%)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent_60%,#05070d_100%)]"></div>
  </div>

  {# Decorative grid #}
  <div class="pointer-events-none absolute inset-0 opacity-[0.06]"
       style="background-image: linear-gradient(rgba(255,255,255,.6) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.6) 1px, transparent 1px); background-size: 56px 56px;"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-10 lg:pt-16 pb-20 lg:pb-28">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-6 items-center">

      {# Text block #}
      <div class="order-2 lg:order-1 text-center lg:text-right" data-aos="fade-up">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-semibold text-white/80">
          <span class="w-1.5 h-1.5 rounded-full bg-brand animate-pulse"></span>
          {{ hero.tagline | default('إصدار جديد · 2026') }}
        </span>

        <h1 class="mt-5 font-black leading-[1.05] text-4xl sm:text-5xl lg:text-6xl tracking-tight">
          <span class="block">{{ product.title }}</span>
          <span class="block bg-clip-text text-transparent bg-gradient-to-l from-accent via-brand to-accent">
            ساعة المستقبل في معصمك
          </span>
        </h1>

        <p class="mt-5 text-base sm:text-lg text-white/70 max-w-xl mx-auto lg:mx-0">
          {{ hero.subtitle | default('ساعة ذكية بشاشة AMOLED مقاس 1.6 بوصة، أكثر من 100 وضع رياضي، ومتابعة صحية متكاملة بتقنية cardoO.') }}
        </p>

        {# Price #}
        <div class="mt-7 flex items-center justify-center lg:justify-start gap-4">
          <div class="flex items-baseline gap-2">
            <span class="text-4xl font-black text-white">{{ product.pricing.price }}</span>
            <span class="text-white/60 font-bold">جنيه</span>
          </div>
          {% if hasDiscount %}
            <span class="text-white/40 line-through text-lg">{{ product.pricing.compareAtPrice }} جنيه</span>
            <span class="px-2 py-1 rounded-md bg-rose-500/15 text-rose-300 text-xs font-bold">خصم</span>
          {% endif %}
        </div>

        {# CTAs #}
        <div class="mt-7 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3">
          <a href="#order"
             class="group inline-flex items-center gap-2 px-7 py-4 rounded-full bg-gradient-to-l from-accent to-brand text-ink-950 font-extrabold text-base shadow-[0_18px_45px_-12px_rgba(124,92,255,.7)] hover:scale-[1.02] transition">
            {{ hero.ctaPrimary | default('اطلب الآن') }}
            <svg class="w-5 h-5 transition group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M19 12H5M11 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href="#features"
             class="inline-flex items-center gap-2 px-7 py-4 rounded-full bg-white/5 border border-white/10 text-white font-bold hover:bg-white/10 transition">
            {{ hero.ctaSecondary | default('اكتشف المميزات') }}
          </a>
        </div>

        {# Trust strip #}
        <div class="mt-8 flex flex-wrap items-center justify-center lg:justify-start gap-x-6 gap-y-3 text-xs text-white/60">
          <span class="inline-flex items-center gap-2"><svg class="w-4 h-4 text-brand" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19l12-12-1.4-1.4z"/></svg> الدفع عند الاستلام</span>
          <span class="inline-flex items-center gap-2"><svg class="w-4 h-4 text-brand" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19l12-12-1.4-1.4z"/></svg> شحن مجاني</span>
          <span class="inline-flex items-center gap-2"><svg class="w-4 h-4 text-brand" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19l12-12-1.4-1.4z"/></svg> ضمان لمدة سنة</span>
        </div>
      </div>

      {# Image block #}
      <div class="order-1 lg:order-2 relative" data-aos="zoom-in" data-aos-delay="100">
        <div class="relative aspect-square max-w-[520px] mx-auto">
          {# Glow disc behind #}
          <div class="absolute inset-0 rounded-full bg-gradient-to-br from-accent/40 to-brand/30 blur-3xl"></div>
          <div class="absolute inset-6 rounded-full bg-gradient-to-br from-ink-800 to-ink-950 border border-white/10"></div>

          {# Floating watch image #}
          {% if heroImg %}
            <img src="{{ heroImg }}" alt="{{ product.title }}"
                 class="relative z-10 w-full h-full object-contain drop-shadow-[0_30px_60px_rgba(124,92,255,0.45)] animate-[float_6s_ease-in-out_infinite]" />
          {% endif %}

          {# Floating chips #}
          <div class="absolute top-6 -start-2 sm:start-4 z-20 px-3 py-2 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 text-xs font-bold flex items-center gap-2" data-aos="fade-down-left" data-aos-delay="400">
            <span class="w-7 h-7 grid place-items-center rounded-full bg-brand text-ink-950">❤</span>
            <div>
              <div class="text-white">78 BPM</div>
              <div class="text-white/60 font-medium">معدل القلب</div>
            </div>
          </div>
          <div class="absolute bottom-10 -end-2 sm:end-4 z-20 px-3 py-2 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 text-xs font-bold flex items-center gap-2" data-aos="fade-up-right" data-aos-delay="500">
            <span class="w-7 h-7 grid place-items-center rounded-full bg-accent text-white">⚡</span>
            <div>
              <div class="text-white">7 أيام</div>
              <div class="text-white/60 font-medium">عمر البطارية</div>
            </div>
          </div>
        </div>
      </div>

    </div>

    {# Scroll hint #}
    <div class="mt-14 flex justify-center">
      <a href="#features" class="text-white/40 text-xs flex flex-col items-center gap-2 hover:text-white transition">
        <span>اسحب للأسفل</span>
        <svg class="w-5 h-5 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>
