<section class="relative py-20 sm:py-28 bg-gradient-to-b from-ink-950 via-[#0b1230] to-ink-950 overflow-hidden">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(124,92,255,0.25),transparent_55%)]"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 grid lg:grid-cols-2 gap-12 items-center">
    <div data-aos="fade-up">
      <span class="text-xs font-bold tracking-[0.3em] uppercase text-brand">الشاشة</span>
      <h2 class="mt-3 text-4xl sm:text-6xl font-black tracking-tight">
        <span class="block">Ultra</span>
        <span class="block bg-clip-text text-transparent bg-gradient-to-r from-accent via-fuchsia-400 to-brand">AMOLED Display</span>
      </h2>
      <p class="mt-5 text-white/70 text-lg leading-relaxed max-w-xl">
        شاشة AMOLED مقاس 1.6 بوصة بألوان حية ونصاعة عالية تظهر كل تفصيلة بدقة سينمائية. اقرأ، تابع وتحكم بسهولة حتى تحت أشعة الشمس.
      </p>

      <ul class="mt-7 space-y-3">
        <li class="flex items-center gap-3"><span class="w-2 h-2 rounded-full bg-brand"></span><span>دقة فائقة وألوان حقيقية</span></li>
        <li class="flex items-center gap-3"><span class="w-2 h-2 rounded-full bg-brand"></span><span>تحكم كامل باللمس بدون تأخير</span></li>
        <li class="flex items-center gap-3"><span class="w-2 h-2 rounded-full bg-brand"></span><span>وضع Always-On لرؤية الوقت دائماً</span></li>
      </ul>
    </div>

    <div class="relative" data-aos="zoom-in">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_rgba(124,92,255,0.4),transparent_60%)] blur-3xl"></div>
      {% if product.images[0] %}
        <img src="{{ product.images[1].fileUrl | default(product.images[0].fileUrl) }}"
             alt="AMOLED display"
             class="relative w-full max-w-lg mx-auto rounded-3xl object-contain drop-shadow-2xl" />
      {% endif %}

      <div class="absolute top-6 right-6 px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-xs font-bold">1.6"</div>
      <div class="absolute bottom-6 left-6 px-3 py-1.5 rounded-full bg-accent text-white text-xs font-bold">AMOLED</div>
    </div>
  </div>
</section>
