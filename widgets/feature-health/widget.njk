<section id="health" class="relative py-20 sm:py-28 bg-gradient-to-b from-ink-950 via-[#10131f] to-ink-950 overflow-hidden">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,_rgba(244,114,182,0.18),transparent_55%)]"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto" data-aos="fade-up">
      <span class="text-xs font-bold tracking-[0.3em] uppercase text-brand">الصحة واللياقة</span>
      <h2 class="mt-3 text-4xl sm:text-5xl font-black tracking-tight">مراقبة الصحة باستمرار</h2>
      <p class="mt-4 text-white/65 text-lg max-w-2xl mx-auto">
        تتبع مجموعة واسعة من مؤشرات الصحة، بما في ذلك معدل ضربات القلب، تشبع الأكسجين في الدم، النوم، مستويات التوتر، والعواطف.
      </p>
    </div>

    <div class="mt-14 grid lg:grid-cols-2 gap-10 items-center">

      <div class="relative" data-aos="zoom-in">
        {% if product.images[5] %}
          <img src="{{ product.images[5].fileUrl }}" alt="health monitor"
               class="w-full rounded-3xl object-cover shadow-2xl" />
        {% endif %}
      </div>

      <div class="grid grid-cols-2 gap-4" data-aos="fade-up">
        <div class="p-5 rounded-2xl bg-rose-500/10 border border-rose-500/20">
          <div class="w-10 h-10 rounded-lg bg-rose-500/20 grid place-items-center text-rose-300 text-xl">❤</div>
          <div class="mt-3 text-2xl font-black">78 <span class="text-xs font-medium text-white/50">BPM</span></div>
          <div class="text-xs text-white/60 mt-1">معدل ضربات القلب</div>
        </div>
        <div class="p-5 rounded-2xl bg-cyan-500/10 border border-cyan-500/20">
          <div class="w-10 h-10 rounded-lg bg-cyan-500/20 grid place-items-center text-cyan-300 text-xl">💧</div>
          <div class="mt-3 text-2xl font-black">98<span class="text-sm">%</span></div>
          <div class="text-xs text-white/60 mt-1">أكسجين الدم (SpO₂)</div>
        </div>
        <div class="p-5 rounded-2xl bg-emerald-500/10 border border-emerald-500/20">
          <div class="w-10 h-10 rounded-lg bg-emerald-500/20 grid place-items-center text-emerald-300 text-xl">🏃</div>
          <div class="mt-3 text-2xl font-black">100+</div>
          <div class="text-xs text-white/60 mt-1">وضع رياضي</div>
        </div>
        <div class="p-5 rounded-2xl bg-violet-500/10 border border-violet-500/20">
          <div class="w-10 h-10 rounded-lg bg-violet-500/20 grid place-items-center text-violet-300 text-xl">😴</div>
          <div class="mt-3 text-2xl font-black">8h</div>
          <div class="text-xs text-white/60 mt-1">تتبع النوم العميق</div>
        </div>
        <div class="col-span-2 p-5 rounded-2xl bg-white/[0.04] border border-white/10 flex items-center gap-4">
          <div class="w-12 h-12 rounded-lg bg-amber-500/20 grid place-items-center text-amber-300 text-xl">⚡</div>
          <div class="flex-1">
            <div class="text-sm font-bold">قياس مستوى التوتر والعواطف</div>
            <div class="text-xs text-white/55 mt-1">للحفاظ على توازنك الذهني طوال اليوم</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
