{% set s = widget.data %}

<section id="order" class="relative py-20 sm:py-28 bg-gradient-to-b from-ink-950 to-[#070b18] overflow-hidden">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(124,92,255,0.25),transparent_55%)]"></div>

  <div class="relative max-w-3xl mx-auto px-4 sm:px-6">
    <qumra-funnel-checkout
      funnel-slug="{{ context.funnel.slug }}"
      mode="{{ s.mode | default('dark') }}"
      primary-color="{{ s.primaryColor | default('#a78bfa') }}"
      radius="{{ s.radius | default(16) }}"
      font-family="{{ s.fontFamily | default('cairo') }}"
    ></qumra-funnel-checkout>
  </div>
</section>
