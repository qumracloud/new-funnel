<section id="features" class="relative py-20 sm:py-28 bg-ink-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto" data-aos="fade-up">
      <span class="text-xs font-bold tracking-[0.3em] text-brand uppercase">المواصفات</span>
      <h2 class="mt-3 text-3xl sm:text-5xl font-black tracking-tight">{{ widget.data.title | default('مميزات تجعلها استثنائية') }}</h2>
      <p class="mt-4 text-white/60">{{ widget.data.subtitle | default('كل ما تحتاجه في معصمك. تصميم أنيق وتقنية متطورة.') }}</p>
    </div>

    <div class="mt-14 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 sm:gap-6">

      {# Always-On Display #}
      <div class="group p-5 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-accent/60 hover:bg-white/[0.06] transition" data-aos="fade-up">
        <div class="w-12 h-12 grid place-items-center rounded-xl bg-accent/15 text-accent group-hover:scale-110 transition">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="9" stroke-linecap="round"/>
            <path d="M12 7v5l3 2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="mt-4 text-sm font-bold">Always-On Display</div>
        <div class="mt-1 text-xs text-white/55">شاشة تعمل دائماً</div>
      </div>

      {# Battery #}
      <div class="group p-5 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-accent/60 hover:bg-white/[0.06] transition" data-aos="fade-up" data-aos-delay="50">
        <div class="w-12 h-12 grid place-items-center rounded-xl bg-brand/15 text-brand group-hover:scale-110 transition">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="7" width="18" height="10" rx="2"/>
            <path d="M22 11v2" stroke-linecap="round"/>
            <path d="M5 10v4M9 10v4M13 10v4" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="mt-4 text-sm font-bold">7 أيام بطارية</div>
        <div class="mt-1 text-xs text-white/55">استخدام متواصل</div>
      </div>

      {# BT Calling #}
      <div class="group p-5 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-accent/60 hover:bg-white/[0.06] transition" data-aos="fade-up" data-aos-delay="100">
        <div class="w-12 h-12 grid place-items-center rounded-xl bg-accent/15 text-accent group-hover:scale-110 transition">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.33 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="mt-4 text-sm font-bold">مكالمات بلوتوث HD</div>
        <div class="mt-1 text-xs text-white/55">تحدث من معصمك</div>
      </div>

      {# Music #}
      <div class="group p-5 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-accent/60 hover:bg-white/[0.06] transition" data-aos="fade-up" data-aos-delay="150">
        <div class="w-12 h-12 grid place-items-center rounded-xl bg-brand/15 text-brand group-hover:scale-110 transition">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18V5l12-2v13" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="6" cy="18" r="3"/>
            <circle cx="18" cy="16" r="3"/>
          </svg>
        </div>
        <div class="mt-4 text-sm font-bold">تشغيل الموسيقى</div>
        <div class="mt-1 text-xs text-white/55">من الساعة مباشرة</div>
      </div>

      {# Dual-core #}
      <div class="group p-5 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-accent/60 hover:bg-white/[0.06] transition" data-aos="fade-up" data-aos-delay="200">
        <div class="w-12 h-12 grid place-items-center rounded-xl bg-accent/15 text-accent group-hover:scale-110 transition">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="4" y="4" width="16" height="16" rx="2"/>
            <rect x="9" y="9" width="6" height="6"/>
            <path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="mt-4 text-sm font-bold">معالج ثنائي النواة</div>
        <div class="mt-1 text-xs text-white/55">أداء فائق السرعة</div>
      </div>

      {# Notifications #}
      <div class="group p-5 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-accent/60 hover:bg-white/[0.06] transition" data-aos="fade-up" data-aos-delay="250">
        <div class="w-12 h-12 grid place-items-center rounded-xl bg-brand/15 text-brand group-hover:scale-110 transition">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M13.73 21a2 2 0 0 1-3.46 0" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="mt-4 text-sm font-bold">مركز الإشعارات</div>
        <div class="mt-1 text-xs text-white/55">رسائل وتنبيهات</div>
      </div>

    </div>
  </div>
</section>
